{
  "name": "@aevum/agent-pay-sdk",
  "version": "1.0.0",
  "private": false,
  "description": "Reusable TypeScript SDK for Aevum PayGuard scoped session keys, ERC-8004 agent discovery, and tUSD8 escrow settlement on QDay Aevum Testnet",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
